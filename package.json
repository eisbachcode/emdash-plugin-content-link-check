{
	"name": "@eisbachcode/emdash-plugin-content-link-check",
	"version": "0.1.0",
	"private": true,
	"description": "EmDash plugin: scheduled link check for your content — broken links, dead domains and redirects.",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"cms",
		"plugin",
		"links",
		"link-checker",
		"seo",
		"audit"
	],
	"license": "MIT",
	"author": "Eisbachcode <daniel@eisbachcode.de>",
	"homepage": "https://github.com/eisbachcode/emdash-plugin-content-link-check#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eisbachcode/emdash-plugin-content-link-check.git"
	},
	"bugs": "https://github.com/eisbachcode/emdash-plugin-content-link-check/issues",
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"registry:login": "emdash-plugin login",
		"registry:publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup",
		"prepublishOnly": "pnpm run build",
		"changeset": "changeset",
		"version-packages": "changeset version"
	},
	"engines": {
		"node": ">=22.16"
	},
	"peerDependencies": {
		"emdash": ">=0.39.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@emdash-cms/plugin-cli": "0.12.0",
		"@emdash-cms/plugin-test": "0.2.3",
		"emdash": ">=0.39.0 <1.0.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@11.15.1"
}
